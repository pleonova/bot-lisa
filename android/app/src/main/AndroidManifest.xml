<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BotLisa"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BotLisa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ListeningForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          work-runtime 2.9.1's own manifest declares this service with no
          foregroundServiceType at all (verified by inspecting its AAR
          manifest directly: it does NOT use a manifest-placeholder
          mechanism, unlike some other AndroidX libraries). Android 14
          (targetSdk 34) requires the type passed to startForeground() at
          runtime to also be declared in the manifest, or the service throws
          MissingForegroundServiceTypeException. ModelDownloadWorker's
          setForeground() call passes FOREGROUND_SERVICE_TYPE_DATA_SYNC, so
          this override (merged over the library's own service tag) has to
          supply the matching declaration ourselves. See
          ON_DEVICE_LLM_PLAN.md Phase 6.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
